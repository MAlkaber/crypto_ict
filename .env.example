# Required: your Anthropic API key (the agent's decision engine)
ANTHROPIC_API_KEY=sk-ant-...

# Only needed for LIVE trading (config mode: live).
# Create the key on Binance with SPOT trading ONLY. Do NOT enable withdrawals or margin/futures.
# Restrict it to your IP address.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Extra confirmation required before any real order is sent:
I_UNDERSTAND_LIVE_TRADING=no

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
